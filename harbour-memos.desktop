[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-memos
Exec=harbour-memos
Name=Memos

[X-Sailjail]
# Kehittäjän / organisaation tunniste (esim. käänteinen domain tai github-tunnus)
OrganizationName=io.github.jarnose
# Sovelluksen sisäinen nimi Sailjailia varten
ApplicationName=memos
# Vaaditut oikeudet: Internet-yhteys on pakollinen Memos-palvelimelle yhdistämiseen
Permissions=Internet
